// D24_UNORM_S8_UINT on a GPU without D24: the layer stores D32_SFLOAT_S8_UINT, and the depth words of a copy
// footprint (24-bit UNORM in bits 0-23, bits 24-31 unspecified) are converted here. depth24_convert_spv.h is this file
// compiled with `glslc --target-env=vulkan1.1 -O -mfmt=c` (see the header for the command); keep them together.
//
// to_float != 0 (upload):   scratch[s] = float bits of the float nearest to d / 16777215, d = app[a] & 0xffffff
// to_float == 0 (readback): app[a]     = D3D's quantisation of scratch[s] (depth24.h; round to nearest even of f * 16777215,
//                           NaN and negatives 0, 1 and above 16777215), the unspecified top byte written as 0
// The upload direction is integer arithmetic (no float division, whose rounding is the GPU's choice); the readback
// uses one float multiply, which Vulkan requires to be correctly rounded, and roundEven.
//
// The same pass repacks 96-bit R32G32B32 texels, which the layer holds in R32G32B32A32 images (D3D-62; `to_float`
// 2 and 3). A footprint texel is then three words and a scratch texel four, and the words are copied as they are:
// to_float == 3 (upload):   scratch[s .. s+2] = app[a .. a+2], scratch[s+3] = 0 (never read: views read alpha as one)
// to_float == 2 (readback): app[a .. a+2]     = scratch[s .. s+2]
//
// The same pass converts R9G9B9E5_SHAREDEXP words and fp16 texels (RT-RGB9E5-HALF; `to_float` 4 and 5): an
// fp16-backed render target reports a 4-byte footprint but its image holds 8-byte fp16 texels. A footprint texel
// is one word (the packed RGB9E5) and a scratch texel two (four fp16 channels). fp16 holds every shared-exponent
// value exactly, so the upload decodes losslessly; the readback quantises as ClearUnorderedAccessViewFloat on WARP
// (uav_clear.h to_rgb9e5): negatives and NaN 0, overflow and +Inf 65408, mantissas half-up, exponent bump on 512.
// to_float == 5 (upload):   scratch[s .. s+1] = the fp16 of the decoded app[a] (alpha 1)
// to_float == 4 (readback): app[a]            = the RGB9E5 of the fp16 scratch[s .. s+1] (alpha dropped)
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer App { uint app[]; };
layout(set = 0, binding = 1) buffer Scratch { uint scratch[]; };

layout(push_constant) uniform Push {
    uint width, height, slices;
    uint to_float;   // 0/1: D24 words and floats; 2/3: 96-bit texels (3/4 words); 4/5: R9G9B9E5 words and fp16 (1/2)
    uint app_base;   // first word of the region in `app`, within the bound window
    uint app_row;    // words between rows and between slices of the app buffer
    uint app_slice;
    uint scratch_base;  // first word of the region in `scratch`, within the bound window
} pc;

// d / (2^24 - 1) as a float. With m the 24-bit mantissa of d (d = m * 2^(e-23)) the quotient is
// (m + m / (2^24 - 1)) * 2^(e-47), and m / (2^24 - 1) lies in (0.5, 1] for every m in [2^23, 2^24], so the nearest
// 24-bit mantissa is m + 1 and the result is exactly float(m + 1) * 2^(e-47).
float depth24_to_float(uint d) {
    if (d == 0u) return 0.0;
    int e = findMSB(d);
    uint m = d << uint(23 - e);
    return float(m + 1u) * uintBitsToFloat(uint(e - 47 + 127) << 23);
}

// The 24-bit UNORM of f as WARP and AMD's D3D12 drivers write it: the product with 2^24 - 1 is rounded to a float
// first, then to the nearest integer with ties to even (NVIDIA's hardware breaks some ties the other way; see
// depth24.h). NaN and negatives give 0, 1 and above the maximum.
uint depth24_from_bits(uint bits) {
    // In unsigned order, all negative encodings and positive NaNs lie above positive infinity.
    if (bits > 0x7f800000u) return 0u;
    if (bits >= 0x3f800000u) return 0xffffffu;
    return uint(roundEven(uintBitsToFloat(bits) * 16777215.0));
}

// The RGB9E5 word of three floats, as WARP's ClearUnorderedAccessViewFloat writes it (uav_clear.h to_rgb9e5).
uint rgb9e5_from_float(float r, float g, float b) {
    const float max_value = 65408.0;
    r = (r > 0.0) ? min(r, max_value) : 0.0;  // !(v > 0): negatives and NaN to 0
    g = (g > 0.0) ? min(g, max_value) : 0.0;
    b = (b > 0.0) ? min(b, max_value) : 0.0;
    float max_c = max(r, max(g, b));
    if (max_c == 0.0) return 0u;
    // frexp(max_c) exponent + 15; max_c is a normal float (>= 2^-24) after the fp16 decode and clamp.
    int exp_shared = max(0, ((floatBitsToInt(max_c) >> 23) & 0xff) - 111);
    float denom = uintBitsToFloat(uint(exp_shared + 103) << 23);  // 2^(exp_shared - 24)
    if (uint(floor(max_c / denom + 0.5)) == 512u) { ++exp_shared; denom *= 2.0; }
    uint rm = uint(floor(r / denom + 0.5));
    uint gm = uint(floor(g / denom + 0.5));
    uint bm = uint(floor(b / denom + 0.5));
    return rm | (gm << 9) | (bm << 18) | (uint(exp_shared) << 27);
}

void main() {
    uvec3 g = gl_GlobalInvocationID;
    if (g.x >= pc.width || g.y >= pc.height || g.z >= pc.slices) return;
    if ((pc.to_float & 4u) != 0u) {
        uint a = pc.app_base + g.z * pc.app_slice + g.y * pc.app_row + g.x;
        uint s = pc.scratch_base + ((g.z * pc.height + g.y) * pc.width + g.x) * 2u;
        if ((pc.to_float & 1u) != 0u) {
            uint word = app[a];
            float scale = uintBitsToFloat(uint(int(word >> 27) + 103) << 23);  // 2^(e - 24), exact
            float r = float(word & 0x1ffu) * scale;
            float gg = float((word >> 9) & 0x1ffu) * scale;
            float b = float((word >> 18) & 0x1ffu) * scale;
            scratch[s] = packHalf2x16(vec2(r, gg));
            scratch[s + 1u] = packHalf2x16(vec2(b, 1.0));
        } else {
            vec2 rg = unpackHalf2x16(scratch[s]);
            vec2 ba = unpackHalf2x16(scratch[s + 1u]);
            app[a] = rgb9e5_from_float(rg.x, rg.y, ba.x);
        }
        return;
    }
    if (pc.to_float >= 2u) {
        uint a = pc.app_base + g.z * pc.app_slice + g.y * pc.app_row + g.x * 3u;
        uint s = pc.scratch_base + ((g.z * pc.height + g.y) * pc.width + g.x) * 4u;
        if (pc.to_float == 3u) {
            scratch[s] = app[a];
            scratch[s + 1u] = app[a + 1u];
            scratch[s + 2u] = app[a + 2u];
            scratch[s + 3u] = 0u;
        } else {
            app[a] = scratch[s];
            app[a + 1u] = scratch[s + 1u];
            app[a + 2u] = scratch[s + 2u];
        }
        return;
    }
    uint a = pc.app_base + g.z * pc.app_slice + g.y * pc.app_row + g.x;
    uint s = pc.scratch_base + (g.z * pc.height + g.y) * pc.width + g.x;
    if (pc.to_float != 0u) scratch[s] = floatBitsToUint(depth24_to_float(app[a] & 0xffffffu));
    else app[a] = depth24_from_bits(scratch[s]);
}
