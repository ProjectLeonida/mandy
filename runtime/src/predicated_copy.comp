// Byte-granular buffer copy or UAV clear inside the captured conditional-rendering scope.
#version 450
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Source { uint8_t bytes[]; } source;
layout(set=0,binding=1,std430) buffer Destination { uint8_t bytes[]; } destination;
layout(push_constant) uniform Copy {
    uint source_offset;
    uint destination_offset;
    uint size;
    uint element_size;
    uint phase;
    uint pattern[4];
} copy;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= copy.size) return;
    uint dst = copy.destination_offset + i;
    if (copy.element_size == 0u) {
        destination.bytes[dst] = source.bytes[copy.source_offset + i];
    } else {
        uint byte_index = (i % copy.element_size + copy.phase) % copy.element_size;
        uint word = copy.pattern[byte_index / 4u];
        destination.bytes[dst] = uint8_t(word >> (8u * (byte_index % 4u)));
    }
}
