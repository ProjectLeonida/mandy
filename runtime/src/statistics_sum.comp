#version 450

// Adds the D3D12_QUERY_DATA_PIPELINE_STATISTICS segments of one split pipeline-statistics query (D3D-162): one
// invocation per counter, in the order of VkQueryPipelineStatisticFlagBits, which is the D3D12 field order.
// Mesh segments place the fragment, compute and optional mesh invocations in consecutive slots 7..9. Slot 5
// holds the mesh-primitives count for both clipping invocations and MSPrimitives. No task stage is supported.
layout(local_size_x = 14) in;
layout(set = 0, binding = 0, std430) buffer QueryResults {
    uvec2 words[];  // totals followed by count segments, all with the same width
};
layout(push_constant) uniform ResolveRange { uint count; uint flags; };

void main() {
    const uint counter = gl_LocalInvocationID.x;
    const bool mesh = (flags & 1u) != 0u;
    const uint width = (flags & 2u) != 0u ? 14u : 11u;
    if (counter >= width) return;
    uvec2 sum = words[counter];
    const bool counted = mesh ? counter == 5u || counter == 7u || counter == 10u ||
                               counter == 12u || counter == 13u : counter < 11u;
    const uint source = !mesh ? counter : counter == 10u ? 8u : counter == 12u ? 9u :
                        counter == 13u ? 5u : counter;
    for (uint i = 0; counted && i < count; ++i) {
        uvec2 segment = words[(i + 1u) * width + source];
        uint low = sum.x + segment.x;
        sum.y += segment.y + uint(low < sum.x);
        sum.x = low;
    }
    words[counter] = sum;
}
